DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Serve existing files/directories directly.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Fallback for client-side routes when the hosting panel does not map them automatically.
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # HTML should not be cached aggressively, so new deploys do not point to old chunks.
  <FilesMatch "\.(html?)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # Fingerprinted assets can be cached for a long time safely.
  <FilesMatch "\.(js|mjs|css|svg|png|jpg|jpeg|gif|webp|mp3|webm|woff|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
